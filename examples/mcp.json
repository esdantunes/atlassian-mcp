{
  "mcpServers": {
    "atlassian-jira": {
      "command": "npx",
      "args": ["-y", "@esdantunes/atlassian-mcp@latest"],
      "env": {
        "JIRA_HOST": "${JIRA_HOST}",
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "JIRA_PROJECT_KEY": "${JIRA_PROJECT_KEY}",
        "ISSUE_CONFIG_PATH": "${ISSUE_CONFIG_PATH}"
      }
    }
  }
}
