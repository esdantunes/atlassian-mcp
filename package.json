{
  "name": "atlassian-bot",
  "version": "1.0.0",
  "description": "Utility for interacting with Atlassian APIs (primarily Jira Cloud)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "bun run build && node dist/index.js",
    "lint": "eslint src",
    "pkg:upd": "bun x npm-check-updates -ui",
    "clean": "rm -rf node_modules dist"
  },
  "keywords": [
    "atlassian",
    "jira",
    "api",
    "typescript"
  ],
  "author": "Eduardo Antunes",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.2.3",
    "eslint": "10.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0"
  },
  "dependencies": {
    "@hono/node-server": "1.19.9",
    "dotenv": "17.3.1",
    "hono": "4.11.9",
    "jira.js": "5.3.0",
    "yaml": "^2.8.2"
  }
}
