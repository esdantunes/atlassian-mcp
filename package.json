{
  "name": "@esdantunes/atlassian-mcp",
  "version": "1.0.0",
  "description": "MCP server for interacting with Jira Cloud via Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "atlassian-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "issue-config.example.yml",
    "gemini-extension.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "bun run build && node dist/index.js",
    "lint": "eslint src",
    "pkg:upd": "bun x npm-check-updates -ui",
    "clean": "rm -rf node_modules dist"
  },
  "keywords": [
    "atlassian",
    "jira",
    "mcp",
    "model-context-protocol",
    "api",
    "typescript",
    "gemini",
    "gemini-cli",
    "ai",
    "automation"
  ],
  "author": "Eduardo Antunes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esdantunes/atlassian-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/esdantunes/atlassian-mcp/issues"
  },
  "homepage": "https://github.com/esdantunes/atlassian-mcp#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "17.4.2",
    "jira.js": "5.3.1",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "overrides": {
    "axios": "1.15.0",
    "minimatch": "10.2.3",
    "brace-expansion": "5.0.5",
    "flatted": "3.4.2",
    "path-to-regexp": "8.4.0",
    "express-rate-limit": "8.2.2",
    "picomatch": "4.0.4",
    "hono": "4.12.12",
    "@hono/node-server": "1.19.14"
  }
}
